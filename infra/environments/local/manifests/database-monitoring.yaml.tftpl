# CloudNativePG scrape config + alerts. Rules come from rules/database.rules.yaml
# (unit-tested in CI); this template only wraps them. Rendered by templatefile().
manifests:
  - apiVersion: monitoring.coreos.com/v1
    kind: PodMonitor
    metadata:
      name: weather-db
    spec:
      selector:
        matchLabels:
          cnpg.io/cluster: weather-db
      podMetricsEndpoints:
        - port: metrics
  - apiVersion: monitoring.coreos.com/v1
    kind: PrometheusRule
    metadata:
      name: weather-db
    spec: ${rules}
