output "kubeconfig_context" {
  value = "kind-${var.cluster_name}"
}

output "app_url" {
  value = "http://localhost:${var.ingress_host_port}"
}

output "database_secret" {
  description = "Secret generated by CloudNativePG - same key contract the chart expects on AWS."
  value       = "${var.app_namespace}/weather-db-app"
}

output "argocd" {
  value = "kubectl -n argocd port-forward svc/argocd-server 8443:80  ->  http://localhost:8443  (admin / `kubectl -n argocd get secret argocd-initial-admin-secret -o jsonpath='{.data.password}' | base64 -d`)"
}
